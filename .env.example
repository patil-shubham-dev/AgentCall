# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ic_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=internet_calling

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_in_production

# JWT
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Service
SERVICE_TOKEN=change_me_in_production
PORT=4000
NODE_ENV=development

# OAuth
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_PRIVATE_KEY=

# coturn
COTURN_SECRET=change_me_in_production
COTURN_REALM=internetcalling.example.com

# Push Notifications
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=

# Caddy
CADDY_DOMAIN=internetcalling.example.com

# MCP Server
MCP_SERVER_PORT=3000
BACKEND_API_URL=http://backend-api:4000/api/v1
