# ──────────────────────────────────────────────
# AgentCall MCP — Environment Variables
# Copy this to .env and fill in your values
# ──────────────────────────────────────────────

## Node Environment
NODE_ENV=development

## PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ic_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=agentcall

## Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_strong_redis_password

## JWT — RSA key pair for access tokens
# Generate keys:
#   openssl genpkey -algorithm RSA -out keys/jwt_private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -pubout -in keys/jwt_private.pem -out keys/jwt_public.pem
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

## Service token — shared secret between MCP server and backend
SERVICE_TOKEN=change_me_service_token_hex_32_bytes

## STUN/TURN (coturn)
COTURN_SECRET=change_me_coturn_hmac_secret
COTURN_REALM=agentcall.example.com

## Push Notifications
### FCM (Android) — Server key from Firebase Console > Cloud Messaging
FCM_SERVER_KEY=

### APNs (iOS) — Apple Push Notification service
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=

## OAuth Providers (optional — for user login)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_PRIVATE_KEY=

## Server Config
BACKEND_API_URL=http://localhost:4000/api/v1
PORT=4000
SIGNALING_PORT=4001
MCP_SERVER_PORT=3000

## Security
CORS_ALLOWED_ORIGINS=*
BODY_LIMIT_BYTES=65536

## Reverse proxy
CADDY_DOMAIN=localhost
