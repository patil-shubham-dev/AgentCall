# AgentCall MCP Server — Environment Variables
# Copy this file to .env and adjust values for your setup.

# Server
MCP_SERVER_PORT=3000
NODE_ENV=development

# Transport: "stdio" (local AI agents) or "sse" (ChatGPT, remote clients)
MCP_TRANSPORT=stdio

# Backend API connection
BACKEND_API_URL=https://agentcall-66ke.onrender.com/api/v1
SERVICE_TOKEN=<REDACTED>

# API key for external AI clients
# Two auth methods supported (both use the same key):
#   1. x-api-key header — Claude Desktop/Code, curl, direct HTTP
#   2. URL path segment — ChatGPT Developer Mode connector (no custom header support)
#      URL format: https://host/mcp/<MCP_API_KEY>
# If empty, authentication is disabled (local dev mode only).
MCP_API_KEY=change-me-to-a-secure-random-string
