# AgentCall MCP Server — Environment Variables
# Copy this file to .env and adjust values for your setup.

# Server
MCP_SERVER_PORT=3000
NODE_ENV=development

# Transport: "stdio" (local AI agents) or "sse" (ChatGPT, remote clients)
MCP_TRANSPORT=stdio

# Backend API connection
BACKEND_API_URL=http://localhost:4000/api/v1
SERVICE_TOKEN=dev-service-token

# API key for external AI clients (ChatGPT, etc.)
# If empty, authentication is disabled (local dev mode).
# Set a secure key for production.
MCP_API_KEY=
