<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Debug-only overlay: lets adb launch the call screens for UI testing.
         Release builds keep both activities non-exported (manifest default). -->
    <application>
        <activity
            android:name=".call.IncomingCallActivity"
            android:exported="true" />
        <activity
            android:name=".call.CallActivity"
            android:exported="true" />

        <!-- Debug-only test hook (battery-audit H2 verification): lets adb start
             a real call session on ROMs that block shell starts of non-exported
             services. Not present in release builds (src/debug overlay). -->
        <receiver
            android:name=".debug.DebugCallTriggerReceiver"
            android:exported="true" />
    </application>

</manifest>