<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- targetSdk 35 applies package visibility filtering: resolveActivity()
         for the dontkillmyapp.com ACTION_VIEW returns null without this,
         breaking the "Guided" link even when a browser is installed. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".AgentCallApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AgentCall">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.AgentCall">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- adjustNothing: on a REAL call this activity hosts ActiveCallScreen
             after the user answers (showCall=true) — CallActivity is skipped
             (EXTRA_LAUNCH_UI=false). The composer owns the IME inset
             exclusively (safeDrawing bottom); the window must never resize or
             pan for the keyboard or the two systems double-compensate and
             leave a keyboard-height dead zone above the IME. -->
        <activity
            android:name=".call.IncomingCallActivity"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:windowSoftInputMode="adjustNothing"
            android:theme="@style/Theme.AgentCall" />

        <!-- adjustNothing: the window must NEVER resize or pan for the IME.
             The activity is edge-to-edge and the composer owns the IME inset
             exclusively via WindowInsets.safeDrawing (single inset owner).
             adjustResize resized the window AND imePadding() padded the
             composer — both consumed the keyboard height once each, leaving
             a full keyboard-height of dead space above the keyboard. -->
        <activity
            android:name=".call.CallActivity"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:windowSoftInputMode="adjustNothing"
            android:theme="@style/Theme.AgentCall" />

        <service
            android:name=".call.CallService"
            android:foregroundServiceType="microphone"
            android:exported="false" />

        <service
            android:name=".call.SignalingForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- Phase A (FCM push-to-wake): receives high-priority data pushes and
             hands rings to SignalingForegroundService. Never exported; FCM
             delivers through the Firebase SDK binding. -->
<service
            android:name=".call.AgentCallMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
