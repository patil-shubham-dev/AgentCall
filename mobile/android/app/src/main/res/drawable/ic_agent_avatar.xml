<?xml version="1.0" encoding="utf-8"?>
<!-- Agent avatar used by the incoming-call notification: the same violet
     identity disc the in-app call screens draw with GradientAvatar. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#7967DE" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_agent"
        android:gravity="center" />
</layer-list>
