<?xml version="1.0" encoding="utf-8"?>
<!--
  AgentCall incoming call notification.

  Flat call surface that sits directly on the notification container: one
  identity row (brand avatar, caller, AI context) and one pair of full-width
  call actions. No inner card, border or decorative layers, so it reads as a
  phone call rather than a card inside a notification. Only
  RemoteViews-supported views are used.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/call_notification_surface"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_call_notification_surface"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:id="@+id/call_notification_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/call_notification_avatar"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_call_notification_avatar"
            android:contentDescription="@string/call_notification_avatar_description"
            android:padding="3dp"
            android:src="@drawable/ic_agentcall_avatar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/call_notification_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:text="@string/call_notification_mode"
                android:textAllCaps="true"
                android:textColor="#A79AF0"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/call_notification_caller"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/call_notification_default_title"
                android:textColor="#F5F3F9"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/call_notification_context"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:text="@string/call_notification_default_context"
                android:textColor="#ACA6BC"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/call_notification_decline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.9"
            android:background="@drawable/bg_call_notification_decline"
            android:clickable="true"
            android:contentDescription="@string/decline"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="50dp"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_call_end"
                android:tint="#FF9298" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/decline"
                android:textColor="#FFA2A7"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- RemoteViews only supports a fixed widget whitelist (Space is not
             on it), so the gap is a margin instead of a spacer view. -->
        <LinearLayout
            android:id="@+id/call_notification_answer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1.1"
            android:background="@drawable/bg_call_notification_answer"
            android:clickable="true"
            android:contentDescription="@string/answer"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="50dp"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_call" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/answer"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
