{
  "name": "@agentcall/voicebridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "VoiceBridge — AI ↔ Human voice bridge. No DB, no Redis, no paid APIs.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:load": "tsx src/__tests__/load-test.ts"
  },
  "dependencies": {
    "@fastify/compress": "^7.0.3",
    "@fastify/cors": "^9.0.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^16.4.0",
    "fastify": "^4.28.0",
    "pg": "^8.22.0",
    "pino": "^9.1.0",
    "pino-pretty": "^11.1.0",
    "ws": "^8.17.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^8.57.0",
    "picomatch": "^4.0.5",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
