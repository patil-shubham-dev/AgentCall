# VoiceBridge Backend — Environment Variables
# Copy this file to .env and adjust values for your setup.

# Server
PORT=4000
SIGNALING_PORT=4001
NODE_ENV=development

# Authentication
SERVICE_TOKEN=dev-service-token

# Speech-to-Text (Whisper, runs locally on CPU)
STT_ENABLED=true
STT_MODEL=Xenova/whisper-base

# CORS
CORS_ALLOWED_ORIGINS=*

# Security
BODY_LIMIT_BYTES=1048576
