# VoiceBridge Backend — Environment Variables
# Copy this file to .env and adjust values for your setup.
# NOTE: never commit a real .env. The dev-service-token is rejected in production.

# Server
PORT=4000
NODE_ENV=development

# Authentication (REQUIRED — set to a secure random string, e.g. `openssl rand -hex 32`)
SERVICE_TOKEN=

# CORS — comma-separated allowlist of browser origins.
# Empty = fail-closed (no CORS headers, browsers block cross-origin requests).
# The MCP browser clients (ChatGPT/Claude web) are always allowed.
CORS_ALLOWED_ORIGINS=

# Security
BODY_LIMIT_BYTES=1048576

# Database (PostgreSQL)
DATABASE_URL=
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_ACQUIRE_TIMEOUT=10000
DB_POOL_IDLE_TIMEOUT=30000

# Persistence mode: memory | dual-write | database-read | database
PERSISTENCE_MODE=dual-write

# Persistence verification (0 = disabled)
DB_VERIFICATION_INTERVAL_MS=300000

# WebSocket Signaling
SIGNALING_MAX_MESSAGE_SIZE=262144
SIGNALING_RATE_LIMIT_MESSAGES=30
SIGNALING_RATE_LIMIT_WINDOW=10
SIGNALING_CONNECTION_RATE_LIMIT=10
# Server->phone heartbeat for dead-connection detection. 60000 matches the
# phone's OkHttp pingInterval; rings ride FCM, so slower detection is free.
SIGNALING_HEARTBEAT_MS=60000

# MCP session idle expiry (closed by the sweep; clients re-initialize)
MCP_SESSION_IDLE_MS=1800000
MCP_SESSION_SWEEP_INTERVAL_MS=60000

# TURN server (coturn) — used by the Android app for NAT traversal.
# COTURN_SECRET must be a random string (letters/digits only), e.g. `openssl rand -hex 32`.
COTURN_SECRET=
COTURN_REALM=example.com

# FCM push-to-wake (Phase A — second ring-delivery path, additive only).
# Disabled by default = fully silent no-op. When enabled, the backend also
# pushes call_incoming to the device's FCM token (client dedupes against the
# WS/poll ring). FIREBASE_SERVICE_ACCOUNT_PATH is the service-account JSON
# from Firebase console (Project Settings → Service accounts) — a secret,
# never commit it.
FCM_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_PATH=
FCM_PROJECT_ID=
